# Copie este arquivo para ".env.local" e preencha com os dados do seu projeto Supabase.
# Enquanto estas variáveis estiverem vazias, o site roda em MODO DEMONSTRAÇÃO
# (dados de exemplo salvos apenas no navegador).

# Supabase → Project Settings → API → Project URL
VITE_SUPABASE_URL=

# Supabase → Project Settings → API → anon / public key
# (esta chave é pública por design; a segurança é garantida pelas políticas RLS)
VITE_SUPABASE_ANON_KEY=

# Endereço público do site (usado em SEO / Open Graph). Ex.: https://www.doisbrilhos.com.br
VITE_SITE_URL=

# NUNCA coloque a "service_role key" aqui. Ela só deve existir nas Edge Functions do Supabase.
